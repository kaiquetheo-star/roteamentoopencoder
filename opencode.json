{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai/glm-5.3-flashx",
  "small_model": "zai/glm-4.5-air",
  "providers": {
    "zai": {
      "name": "Z.AI",
      "env": ["ZAI_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      },
      "models": {
        "glm-5.3": { "name": "GLM-5.3", "modelID": "glm-5.3" },
        "glm-5.3-flashx": { "name": "GLM-5.3-FlashX", "modelID": "glm-5.3-flashx" },
        "glm-4.5-air": { "name": "GLM-4.5-Air", "modelID": "glm-4.5-air" }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" }
  ]
}
